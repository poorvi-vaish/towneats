# Postgres connection string.
# Production: create a free database at https://neon.tech (or Supabase),
# paste its connection string here AND in Vercel → Settings → Environment Variables.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Razorpay (leave empty to use manual UPI mode for the pilot)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Manual UPI fallback (used when Razorpay keys are empty)
MANUAL_UPI_ID="yourname@upi"

# Admin dashboard access — use a long random string
ADMIN_SECRET="change-me-to-a-long-random-string"

# Business config
DELIVERY_FEE_PAISE="5000"
SERVICED_AREAS="Main Bazaar,Station Area,Gandhi Nagar,Shastri Park,College Road,Old Town"
NEXT_PUBLIC_TOWN_NAME="Your Town"
NEXT_PUBLIC_CITY_NAME="The City"
NEXT_PUBLIC_SUPPORT_PHONE="9000000000"
NEXT_PUBLIC_SUPPORT_WHATSAPP="919000000000"
